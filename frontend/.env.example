# Optional server-side LLM for the Evidence Copilot.
# Copy to .env.local (git-ignored) and fill in the key, or set these in your shell / hosting provider.
# Never prefix them with VITE_: VITE_* variables are bundled into browser code, and the build
# refuses to run if a key-like VITE_* variable is set.
OPENROUTER_API_KEY=
# Optional; defaults to openrouter/auto.
OPENROUTER_MODEL=
